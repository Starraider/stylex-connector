{
    "name": "skom/stylex-connector",
    "description": "StyleX Connector - Bridges StyleX build-time CSS authoring with TYPO3 Fluid templates.",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": ["typo3", "stylex", "css", "fluid", "viewhelper"],
    "homepage": "https://github.com/Starraider/stylex-connector",
    "support": {
        "issues": "https://github.com/Starraider/stylex-connector/issues",
        "source": "https://github.com/Starraider/stylex-connector"
    },
    "authors": [
        {
            "name": "Sven Kalbhenn",
            "email": "sven@skom.de"
        }
    ],
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "require": {
        "php": ">=8.1 <8.5",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-fluid": "^12.4 || ^13.4 || ^14.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "typo3/testing-framework": "^8.0 || ^9.0",
        "typo3/coding-standards": "^0.8",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "suggest": {
        "bk2k/bootstrap-package": "When using Bootstrap Package alongside StyleX.",
        "praetorius/vite-asset-collector": "For Vite-based asset management in TYPO3."
    },
    "autoload": {
        "psr-4": {
            "Vendor\\StylexConnector\\": "Classes/"
        },
        "files": [
            "Configuration/Compatibility.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\StylexConnector\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "stylex_connector",
            "version": "1.0.0",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
