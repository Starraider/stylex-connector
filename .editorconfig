root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.js]
indent_size = 2

[*.json]
indent_style = space
indent_size = 4

[*.rst]
indent_size = 3

[*.{typoscript,tsconfig}]
indent_size = 2

[{*.yml,*.yaml}]
indent_size = 2

[*.xlf]
indent_style = space
indent_size = 4

[*.md]
max_line_length = 80
