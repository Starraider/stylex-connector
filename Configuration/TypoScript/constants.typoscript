plugin.tx_stylexconnector {
    settings {
        # cat=stylex_connector/basic/10; type=string; label=StyleX CSS file path (Vite output)
        # Leave empty if using <vite:asset> in Fluid templates directly.
        # Use an absolute web path or EXT: path if loading CSS via TypoScript.
        # Example: /typo3temp/assets/vite/assets/Main.entry-abc123.css
        cssFilePath =

        # cat=stylex_connector/basic/20; type=boolean; label=Include CSS via TypoScript
        # Set to 1 to include StyleX CSS via TypoScript instead of <vite:asset> in templates.
        # Set to 0 if your Fluid layout already uses <vite:asset> (recommended).
        includeCssViaTypoScript = 0

        # cat=stylex_connector/basic/30; type=boolean; label=Declare CSS @layer ordering
        # Deprecated, no output. Put layer order first in the CSS build.
        # Only relevant when Bootstrap is also loaded.
        declareCssLayers = 0

        # cat=stylex_connector/basic/40; type=integer; label=StyleX CSS include priority
        # Deprecated, ignored. TYPO3 has no numeric includeCSS priority.
        # Retained for configuration compatibility.
        cssPriority = 60

        # cat=stylex_connector/basic/50; type=integer; label=Bootstrap CSS include priority
        # Deprecated, ignored.
        bootstrapCssPriority = 40

        # cat=stylex_connector/advanced/10; type=boolean; label=Override Bootstrap priority
        # Legacy name: sets forceOnTop for known Bootstrap CSS asset names.
        overrideBootstrapPriority = 0
    }
}
