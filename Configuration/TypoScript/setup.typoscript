# ===========================================================================
# StyleX Connector — TypoScript Setup
# ===========================================================================
# This file handles:
# 1. Optional CSS inclusion via TypoScript (if not using <vite:asset> in Fluid)
# 2. CSS @layer declaration for Bootstrap + StyleX coexistence
# 3. Fluid global namespace registration
# ===========================================================================

# ---------------------------------------------------------------------------
# Global Fluid namespace — makes {stylex:class(...)} available in all templates
# ---------------------------------------------------------------------------
config.fluid.namespace.stylex = Vendor\StylexConnector\ViewHelpers

# ---------------------------------------------------------------------------
# Optional: Include StyleX CSS via TypoScript
# Only active when plugin.tx_stylexconnector.settings.includeCssViaTypoScript = 1
# ---------------------------------------------------------------------------
[{$plugin.tx_stylexconnector.settings.includeCssViaTypoScript} == 1]

    page.includeCSS {
        stylex_connector = {$plugin.tx_stylexconnector.settings.cssFilePath}
        stylex_connector {
            # Load AFTER Bootstrap (controlled by priority)
            priority = {$plugin.tx_stylexconnector.settings.cssPriority}
            # Disable TYPO3's built-in minification for Vite-optimized CSS
            disableCompression = 1
            # Exclude from concatenation (already optimized by Vite)
            excludeFromConcatenation = 1
            # Ensure media=all for immediate application
            media = all
        }
    }

[END]

# ---------------------------------------------------------------------------
# CSS @layer declaration — ensures @layer priority order in the browser.
# Injected as an inline style block before all other CSS.
# Only active when declareCssLayers = 1.
# ---------------------------------------------------------------------------
[{$plugin.tx_stylexconnector.settings.declareCssLayers} == 1]

    page.headerData.100 = TEXT
    page.headerData.100.value (
        <style>
        /* StyleX Connector: CSS layer priority declaration */
        /* Ensures Bootstrap styles are in a lower layer than StyleX styles. */
        @layer bootstrap, stylex, overrides;
        </style>
    )
    # Priority 100 ensures this renders before any CSS includes
    page.headerData.100.insertData = 0

[END]

# ---------------------------------------------------------------------------
# Bootstrap priority override (when overrideBootstrapPriority = 1)
# Lowers Bootstrap CSS priority so StyleX (priority 60) loads after it.
# Works with both bootstrap_package and manually included Bootstrap CSS.
# ---------------------------------------------------------------------------
[{$plugin.tx_stylexconnector.settings.overrideBootstrapPriority} == 1]

    # Override bootstrap_package's Bootstrap CSS priority if present
    page.includeCSS.bootstrap.priority = {$plugin.tx_stylexconnector.settings.bootstrapCssPriority}
    page.includeCSS.bootstrap_package_bootstrap.priority = {$plugin.tx_stylexconnector.settings.bootstrapCssPriority}

    # Override CDN-included Bootstrap if sitepackage loads it as "bootstrap_cdn"
    page.includeCSS.bootstrap_cdn.priority = {$plugin.tx_stylexconnector.settings.bootstrapCssPriority}

[END]
